--- !u!114 &1667127799
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1667127797}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: " L\u1ED1i ch\u01A1i\nB\u1EA1n s\u1EBD v\xE0o vai m\u1ED9t hi\u1EC7p s\u0129
    d\u0169ng c\u1EA3m b\u01B0\u1EDBc v\xE0o h\xE0nh tr\xECnh chi\u1EBFn \u0111\u1EA5u
    ch\u1ED1ng l\u1EA1i l\u0169 qu\xE1i v\u1EADt, v\u1EDBi 2 ch\u1EBF \u0111\u1ED9
    ch\u01A1i h\u1EA5p d\u1EABn:\n\n Ch\u1EBF \u0111\u1ED9 Online \u2013 PvP & Co-op\nT\u1EA1o
    ho\u1EB7c tham gia ph\xF2ng ch\u01A1i online c\xF9ng nh\u1EEFng ng\u01B0\u1EDDi
    ch\u01A1i kh\xE1c.\n\nChi\u1EBFn \u0111\u1EA5u PvP: So t\xE0i k\u1EF9 n\u0103ng
    chi\u1EBFn \u0111\u1EA5u v\u1EDBi ng\u01B0\u1EDDi ch\u01A1i trong ph\xF2ng, tranh
    v\u1ECB tr\xED d\u1EABn \u0111\u1EA7u b\u1EA3ng x\u1EBFp h\u1EA1ng.\n\n\u0110\xE1nh
    Boss & Qu\xE1i v\u1EADt c\xF9ng nhau: K\u1EBFt h\u1EE3p c\xF9ng ng\u01B0\u1EDDi
    ch\u01A1i kh\xE1c ti\xEAu di\u1EC7t qu\xE1i theo \u0111\u1EE3t (wave) ho\u1EB7c
    boss c\u1EF1c m\u1EA1nh.\n\nB\u1EA3ng x\u1EBFp h\u1EA1ng trong ph\xF2ng: C\u1EA1nh
    tranh ai l\xE0 ng\u01B0\u1EDDi di\u1EC7t nhi\u1EC1u qu\xE1i nh\u1EA5t, nh\u1EADn
    ph\u1EA7n th\u01B0\u1EDFng danh v\u1ECDng m\u1ED7i tr\u1EADn.\n\n Ch\u1EBF \u0111\u1ED9
    Offline \u2013 S\u0103n Qu\xE1i Theo Wave\nV\xE0o game v\xE0 chi\u1EBFn \u0111\u1EA5u
    v\u1EDBi l\u0169 qu\xE1i theo t\u1EEBng \u0111\u1EE3t (wave) kh\xF4ng ng\u1EEBng
    ngh\u1EC9.\n\nQu\xE1i v\u1EADt ng\xE0y c\xE0ng m\u1EA1nh h\u01A1n, nhanh h\u01A1n
    \u2013 \u0111\xF2i h\u1ECFi b\u1EA1n n\xE2ng c\u1EA5p nh\xE2n v\u1EADt v\xE0
    v\u0169 kh\xED li\xEAn t\u1EE5c.\n\nNh\u1EADn v\xE0ng, \u0111\xE1 qu\xFD, v\u1EADt
    ph\u1EA9m qua m\u1ED7i wave \u0111\u1EC3 n\xE2ng c\u1EA5p s\u1EE9c m\u1EA1nh.\n\n
    T\xEDnh n\u0103ng n\u1ED5i b\u1EADt\n Ch\u01A1i \u0111\u01B0\u1EE3c c\u1EA3 Online
    v\xE0 Offline\n\nN\xE2ng c\u1EA5p v\u0169 kh\xED, gi\xE1p v\xE0 k\u1EF9 n\u0103ng
    \n\n X\u1EBFp h\u1EA1ng ph\xF2ng \u0111\u1EA5u v\xE0 b\u1EA3ng danh v\u1ECDng\n\n
    H\u1EC7 th\u1ED1ng ph\u1EA7n th\u01B0\u1EDFng, nhi\u1EC7m v\u1EE5 h\xE0ng ng\xE0y\n\n
    \u0110\u1ED3 h\u1ECDa pixel phong c\xE1ch c\u1ED5 \u0111i\u1EC3n d\u1EC5 th\u01B0\u01A1ng"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 44c4b1dc6b9f1c746af76411c7a28d28, type: 2}
